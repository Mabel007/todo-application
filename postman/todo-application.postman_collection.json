      "item": [
        {
          "name": "API-001 Register synthetic primary user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const unique = Date.now() + '-' + pm.variables.replaceIn('{{$randomInt}}');",
                  "pm.collectionVariables.set('qaEmail', 'ta203.qa.' + unique + '@example.test');",
                  "pm.collectionVariables.set('qaPassword', 'Ta203!' + unique + 'Aa');",
                  "['accessToken', 'refreshToken', 'taskId', 'userId'].forEach(function (key) { pm.environment.unset(key); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('Registration returns top-level user and tokens', function () {",
                  "  pm.expect(json.user.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.refreshToken).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('Capture required authentication variables', function () {",
                  "  pm.environment.set('accessToken', json.accessToken);",
                  "  pm.environment.set('refreshToken', json.refreshToken);",
                  "  pm.environment.set('userId', json.user.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"TA-203 Synthetic Primary\",\n  \"email\": \"{{qaEmail}}\",\n  \"password\": \"{{qaPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/auth/register",
              "host": ["{{baseURL}}"],
              "path": ["auth", "register"]
            },
            "description": "Traceability: API-001. Clears stale runtime state before generating a disposable synthetic identity."
          }
        },
